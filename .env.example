# Isolated CurrentJabe Supabase project. Never point these at another production app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Salts anonymous visitor identifiers before they are stored. Use 32+ random characters.
VISITOR_HASH_SECRET=

# Single-operator CMS credentials and cookie-signing secret.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Canonical public deployment URL used by metadata, social cards and sitemaps.
NEXT_PUBLIC_SITE_URL=https://current-jabe.vercel.app

# Optional Google Search Console HTML-tag verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
